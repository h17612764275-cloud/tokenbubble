{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Bubble 余量浮窗",
  "version": "0.2.2",
  "identifier": "app.tokenbubble.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "widget",
        "title": "Token Bubble 余量浮窗",
        "width": 88,
        "height": 88,
        "minWidth": 88,
        "minHeight": 88,
        "maxWidth": 340,
        "maxHeight": 340,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      },
      {
        "label": "tray-panel",
        "title": "Token Bubble 余量浮窗",
        "url": "index.html?view=tray",
        "width": 380,
        "height": 504,
        "minWidth": 330,
        "minHeight": 430,
        "maxWidth": 720,
        "maxHeight": 820,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "screenshot",
        "title": "Token Bubble 截图",
        "backgroundThrottling": "disabled",
        "url": "index.html?view=screenshot",
        "width": 1,
        "height": 1,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#09111f",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "pin",
        "title": "Token Bubble 贴图",
        "url": "index.html?view=pin",
        "width": 720,
        "height": 520,
        "minWidth": 120,
        "minHeight": 80,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "quick-actions",
        "title": "Token Bubble 快捷功能",
        "url": "index.html?view=quick-actions",
        "width": 280,
        "height": 90,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "category": "Utility",
    "publisher": "Token Bubble contributors",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "shortDescription": "Codex quota at a glance",
    "longDescription": "A lightweight floating desktop card for Codex usage limits.",
    "copyright": "Copyright Token Bubble contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/codexscope/": "codexscope/"
    }
  }
}
